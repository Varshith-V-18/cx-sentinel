# Copy this file to .env and fill in your key.
# The app works without a Groq key too (falls back to rule-based
# analysis), but the LLM-powered version is what you want for the demo.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Defaults to local SQLite if unset. On Render, set this to the
# Postgres connection string from your Render Postgres instance.
DATABASE_URL=sqlite:///./cx_sentinel.db
